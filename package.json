{
  "name": "excel-template-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "validate": "node --experimental-strip-types scripts/validate-templates.mts",
    "xlsx": "./.venv/bin/python scripts/build_xlsx.py",
